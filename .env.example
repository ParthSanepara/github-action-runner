# ============================================================================
# github-action-runner — configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the required values:
#     cp .env.example .env
#
# At minimum you must set:
#   (1) ONE auth method     — GITHUB_PAT  OR  RUNNER_TOKEN
#   (2) ONE registration scope — GITHUB_REPOSITORY  OR  GITHUB_ORG
#
# Everything else is optional.
# ============================================================================


# ----------------------------------------------------------------------------
# (1) AUTH — set exactly ONE of the two options below
# ----------------------------------------------------------------------------

# Option A (RECOMMENDED): Personal Access Token
#   - The container exchanges this for a fresh registration token on every
#     start, so the runner can restart forever without manual intervention.
#   - Create at: https://github.com/settings/tokens
#   - Scopes:
#       * Repo runner  → classic PAT with `repo`
#                        (or fine-grained PAT with "Administration: Read & Write")
#       * Org runner   → classic PAT with `admin:org`
GITHUB_PAT=ghp_xxx

# Option B: One-shot registration token
#   - Grab from: <repo or org> → Settings → Actions → Runners → New runner
#   - Expires in ~1 hour. Once expired, the container will fail to re-register.
#   - Only useful for quick tests. Delete the GITHUB_PAT line above if you use this.
# RUNNER_TOKEN=AHCMDY...


# ----------------------------------------------------------------------------
# (2) SCOPE — set exactly ONE of the two below
# ----------------------------------------------------------------------------

# Register the runner against a single repository.
GITHUB_REPOSITORY=pslabel/pslabel-snap

# Or register against an entire organization (any repo in the org can use it).
# GITHUB_ORG=my-org


# ----------------------------------------------------------------------------
# OPTIONAL settings
# ----------------------------------------------------------------------------

# Display name in the GitHub Runners UI. Defaults to the container hostname,
# which is fine for `docker compose up --scale runner=N` (each gets a unique one).
# RUNNER_NAME=my-runner-01

# Extra labels added to the runner. Workflows target runners with
# `runs-on: [self-hosted, linux, <your-label>]`. Defaults to "self-hosted,linux".
# RUNNER_LABELS=self-hosted,linux,gpu

# Org-only: assign the runner to a specific runner group. Ignored for repo runners.
# RUNNER_GROUP=default

# Working directory inside the container for job checkouts. Default: _work
# RUNNER_WORKDIR=_work
